{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literature-radar:schema:attention-memory:v1",
  "title": "Literature Radar attention-memory v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1
    },
    "preferred_concept_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "preferred_concept_ids"
  ],
  "additionalProperties": false
}
