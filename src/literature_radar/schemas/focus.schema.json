{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:literature-radar:schema:focus:v1",
  "title": "Literature Radar focus v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "topic_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]{3,}$"
    },
    "search_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "topic_id",
    "version",
    "search_terms"
  ],
  "additionalProperties": false
}
